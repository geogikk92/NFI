# Копирай като .env.local и попълни. НИКОГА не качвай .env.local в git.

DATABASE_URL="postgresql://..."

AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Mollie (плащания: карти, PayPal, Klarna, SEPA)
MOLLIE_API_KEY=""
MOLLIE_WEBHOOK_SECRET=""

# Съхранение на файлове (S3 / Cloudflare R2, EU регион)
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Имейл
RESEND_API_KEY=""
EMAIL_FROM="NFI <info@...>"

# НАП / Take a NAP
TAKEANAP_API_KEY=""
NAP_SHOP_NUMBER=""

# Реквизити на продавача — влизат във всяка фактура (ЗДДС чл. 114).
# Без тях lib/legal.getSellerDetails() хвърля и фактура не се издава.
SELLER_NAME=""
SELLER_EIK=""
# При SME режим в ЕС номерът завършва на "-EX". Празно = нерегистриран.
SELLER_VAT_ID=""
SELLER_ADDRESS=""
SELLER_MOL=""

# Админ панел. БЕЗ него панелът е ЗАКЛЮЧЕН — това е нарочно: липсваща
# променлива не бива да значи „всеки е админ". Имейлът трябва да
# съществува в базата с роля ADMIN.
ADMIN_EMAIL=""

# Приложение
APP_URL="http://localhost:3000"
DOC_RETENTION_DAYS="60"
