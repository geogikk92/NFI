# Копирай като .env.local и попълни. НИКОГА не качвай .env.local в git.

# Pooled низът от доставчика, но със sslmode=verify-full, НЕ require:
# днешният драйвер ги приравнява, следващата голяма версия на `pg` — не, и
# `require` ще значи „криптирай, без да проверяваш сертификата".
DATABASE_URL="postgresql://user:pass@host/db?sslmode=verify-full"

# Auth.js (next-auth) е инсталиран, но НЕ се ползва: сесията е ред в
# таблицата Session, не JWT — виж lib/auth/session.ts. Двете променливи
# стоят празни и не се четат отникъде. Ще потрябват, ако дойде вход с
# Google или друг външен доставчик.
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Mollie (плащания: карти, PayPal, Klarna, SEPA)
MOLLIE_API_KEY=""
MOLLIE_WEBHOOK_SECRET=""

# Съхранение на файлове (S3 / Cloudflare R2, EU регион).
# S3 драйверът се включва само при ПЪЛЕН набор: ENDPOINT + BUCKET + двата
# ключа. Непълен набор пада към локалния драйвер (uploads/) — S3_ENDPOINT
# е част от проверката, защото R2 винаги иска endpoint и bucket+ключове
# без него биха тръгнали към AWS вместо към R2.
# За R2 с EU юрисдикция: https://<ACCOUNT_ID>.eu.r2.cloudflarestorage.com
S3_ENDPOINT=""
# За R2 регионът е винаги "auto" (празно също значи auto).
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Имейл
RESEND_API_KEY=""
EMAIL_FROM="NFI <info@...>"

# НАП / Take a NAP
TAKEANAP_API_KEY=""
NAP_SHOP_NUMBER=""

# Реквизити на продавача — влизат във всяка фактура (ЗДДС чл. 114).
# Без тях lib/legal.getSellerDetails() хвърля и фактура не се издава.
SELLER_NAME=""
SELLER_EIK=""
# При SME режим в ЕС номерът завършва на "-EX". Празно = нерегистриран.
SELLER_VAT_ID=""
SELLER_ADDRESS=""
SELLER_MOL=""

# Админ панел. НЕ дава достъп сам по себе си — достъпът иска ВХОД (сесия)
# плюс роля ADMIN в базата. Тази променлива е само предпазител: зададена,
# стеснява панела до един конкретен имейл дори роля ADMIN да получи някой
# друг по грешка. Празна = достатъчна е ролята.
#
# Парола за първия вход:
#   npm run admin:password -- admin@nfi.local
ADMIN_EMAIL=""

# Приложение
APP_URL="http://localhost:3000"
DOC_RETENTION_DAYS="60"
